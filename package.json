{
  "name": "appli-nutrition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application de nutrition et de planification de repas — 100% locale, sans IA, sans compte.",
  "scripts": {
    "build": "node --experimental-sqlite catalog/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "catalog:ciqual": "node catalog/import-ciqual.mjs",
    "engine:similarity": "tsx app/src/cli/mesure-similarite.ts",
    "catalog:list": "tsx app/src/cli/list-recipes.ts",
    "engine:try": "tsx app/src/cli/try-engine.ts",
    "engine:plan": "tsx app/src/cli/try-planning.ts",
    "engine:plan-stress": "tsx app/src/cli/stress-planning.ts",
    "engine:plancher": "tsx app/src/cli/diag-plancher.ts",
    "engine:couverture": "tsx app/src/cli/diag-couverture.ts",
    "engine:calibrate-lambda": "tsx app/src/cli/calibre-lambda.ts",
    "catalog:gonfler": "node catalog/gonfler-pour-mesure.mjs",
    "mesure:61": "node catalog/preparer-mesure-61.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "icons:build": "node catalog/build-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.1.1",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
